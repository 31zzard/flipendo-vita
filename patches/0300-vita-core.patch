diff --git a/SurrealEngine/Utils/AlignedAlloc.h b/SurrealEngine/Utils/AlignedAlloc.h
index 2108ccf6..612a7a2e 100644
--- a/SurrealEngine/Utils/AlignedAlloc.h
+++ b/SurrealEngine/Utils/AlignedAlloc.h
@@ -1,11 +1,19 @@
 #pragma once
 
 #include <cstdlib>
+#ifdef __vita__
+#include <malloc.h>
+#endif
 
 inline void* AlignedAlloc(std::size_t alignment, std::size_t size)
 {
 #ifdef _MSC_VER
 	return _aligned_malloc(size, alignment);
+#elif defined(__vita__)
+	// newlib on the Vita has no std::aligned_alloc; memalign is its aligned allocator,
+	// and its blocks are released with free().
+	alignment = alignment < alignof(void*) ? alignof(void*) : alignment;
+	return memalign(alignment, size);
 #else
 	// std::aligned_alloc requires an alignment accepted by the platform and a
 	// size that is an exact multiple of that alignment. Also, macOS refuse
@@ -25,4 +33,4 @@ inline void AlignedFree(void* data)
 #else
 	std::free(data);
 #endif
-}
+}
